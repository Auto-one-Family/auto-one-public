# AutomationOne - CI Environment Variables (Example)
# =====================================================
# Copy this file to .env.ci and fill in real values.
# Purpose: Used by docker-compose.ci.yml in GitHub Actions
#
# CI-specific test values (not production secrets):
# POSTGRES_PASSWORD, JWT_SECRET_KEY are intentionally weak CI-only values.
# E2E_TEST_PASSWORD must be set via GitHub Actions secret: secrets.E2E_TEST_PASSWORD

# PostgreSQL
POSTGRES_USER=god_kaiser
POSTGRES_PASSWORD=ci_password
POSTGRES_DB=god_kaiser_db

# Database URL (for server and tests)
DATABASE_URL=postgresql+asyncpg://god_kaiser:ci_password@postgres:5432/god_kaiser_db

# MQTT
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883

# Server
ENVIRONMENT=testing
LOG_LEVEL=WARNING
TESTING=true

# JWT (CI-only, not for production!)
JWT_SECRET_KEY=ci_test_secret_key_not_for_production

# E2E credentials — set via GitHub Actions secret E2E_TEST_PASSWORD
E2E_TEST_USER=admin
E2E_TEST_PASSWORD=your_admin_password_here
